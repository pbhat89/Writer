flowchart LR
    subgraph r1 [" "]
    direction LR
    A["1 · Ideate<br/>& scope"] --> B["2 · Spec<br/>(the WHAT)"] --> C["3 · Plan<br/>(the HOW)"] --> D["4 · Break<br/>into tasks"]
    end
    subgraph r2 [" "]
    direction LR
    E["5 · Build"] --> F["6 · Review<br/>& secure"] --> G["7 · Test<br/>& verify"] --> H["8 · Ship<br/>& watch"]
    end
    D --> E
    F -. "bug / gap" .-> E
    G -. "fails" .-> E
    style r1 fill:none,stroke:none
    style r2 fill:none,stroke:none

    classDef stage fill:#eef2f7,stroke:#3f566f,stroke-width:1px,color:#12202f;
    class A,B,C,D,E,F,G,H stage;
